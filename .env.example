# Local PostgreSQL + pgvector (docker compose up -d postgres)
DATABASE_URL=postgresql://video_summary:video_summary_dev@localhost:5432/video_summary

# Set these only when using live providers. Never commit a populated .env.
DEEPGRAM_API_KEY=
PYANNOTE_AUTH_TOKEN=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Provider selection is intentionally explicit.
ASR_PROVIDER=fixture
DIARIZATION_PROVIDER=fixture
LLM_PROVIDER=fixture
EMBEDDING_PROVIDER=fixture

